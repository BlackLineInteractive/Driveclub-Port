# ---- host shaders (GLSL -> SPIR-V headers) ----
find_program(DC_GLSLANG NAMES glslang glslangValidator REQUIRED)
set(DC_SHADPS4_SRC ${CMAKE_SOURCE_DIR}/third_party/shadps4/src)
set(DC_HOST_SHADER_DIR ${CMAKE_BINARY_DIR}/host_shaders/include/video_core/host_shaders)
set(DC_HOST_SHADERS "")
function(dc_host_shader file name)
    set(header ${DC_HOST_SHADER_DIR}/${name}.h)
    string(TOUPPER ${name} symbol)
    set(defines ${ARGN})
    list(TRANSFORM defines PREPEND "-D")
    add_custom_command(
        OUTPUT ${header}
        COMMAND ${CMAKE_COMMAND} -E make_directory ${DC_HOST_SHADER_DIR}
        COMMAND ${DC_GLSLANG} --target-env vulkan1.3 -o ${header} --vn ${symbol} ${defines}
                ${DC_SHADPS4_SRC}/video_core/host_shaders/${file}
        COMMAND ${CMAKE_COMMAND} "-DHEADER_FILE=${header}"
                -P ${DC_SHADPS4_SRC}/video_core/host_shaders/AddShaderHeaderInclude.cmake
        DEPENDS ${DC_SHADPS4_SRC}/video_core/host_shaders/${file}
        COMMENT "Host shader ${file} -> ${name}.h"
        VERBATIM)
    set(DC_HOST_SHADERS ${DC_HOST_SHADERS} ${header} PARENT_SCOPE)
endfunction()
dc_host_shader(color_to_ms_depth.frag color_to_ms_depth_frag)
dc_host_shader(ms_image_blit.frag ms_image_blit_frag)
dc_host_shader(ms_image_blit.frag ms_image_blit_msaa_frag SRC_MSAA=1)
dc_host_shader(fault_buffer_process.comp fault_buffer_process_comp)
dc_host_shader(fs_tri.vert fs_tri_vert)
dc_host_shader(post_process.frag post_process_frag)
foreach (bpp IN ITEMS 8 16 32 64 96 128)
    dc_host_shader(tiling.comp tiling_micro_${bpp}_comp BITS_PER_PIXEL=${bpp} IS_MACRO_TILED=0)
    dc_host_shader(tiling.comp tiling_macro_${bpp}_comp BITS_PER_PIXEL=${bpp} IS_MACRO_TILED=1)
endforeach()
add_custom_target(dc_host_shaders DEPENDS ${DC_HOST_SHADERS})

# ---- the library ----
file(GLOB_RECURSE DC_SHADPS4_SOURCES CONFIGURE_DEPENDS
     ${DC_SHADPS4_SRC}/video_core/*.cpp
     ${DC_SHADPS4_SRC}/shader_recompiler/*.cpp
     ${DC_SHADPS4_SRC}/common/*.cpp)
add_library(dc_shadps4_vulkan STATIC
    ${DC_SHADPS4_SOURCES}
    src/gpu/vulkan/shim/shim.cpp
    src/gpu/vulkan/backend/dc_vulkan.cpp)
add_dependencies(dc_shadps4_vulkan dc_host_shaders)
target_include_directories(dc_shadps4_vulkan PRIVATE
    src/gpu/vulkan/shim          # first: shadows the shadPS4 headers we replace
    ${DC_SHADPS4_SRC}
    ${CMAKE_BINARY_DIR}/host_shaders/include
    ${half_dir}/include
    ${tracy_dir}/public
    PUBLIC src/gpu/vulkan/bridge)
target_compile_features(dc_shadps4_vulkan PRIVATE cxx_std_23)
target_compile_definitions(dc_shadps4_vulkan PRIVATE BOOST_ASIO_STANDALONE
    $<$<PLATFORM_ID:Windows>:NOMINMAX WIN32_LEAN_AND_MEAN>)
# Third-party code: keep its warnings out of our build log.
target_compile_options(dc_shadps4_vulkan PRIVATE
    $<$<CXX_COMPILER_ID:Clang,AppleClang,GNU>:-w -march=x86-64-v3>
    $<$<OBJCXX_COMPILER_ID:Clang,AppleClang>:-w>)
target_link_libraries(dc_shadps4_vulkan PRIVATE
    Vulkan::Headers GPUOpen::VulkanMemoryAllocator Boost::headers fmt::fmt
    magic_enum::magic_enum tsl::robin_map xbyak::xbyak Zydis sirit dc_xxhash dc_miniz SDL3::SDL3)
