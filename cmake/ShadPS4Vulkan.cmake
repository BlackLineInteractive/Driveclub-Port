# The Vulkan renderer: shadPS4's video_core + shader_recompiler
# (third_party/shadps4, GPL-2.0-or-later) built as the static library
# dc_shadps4_vulkan, with the shims in src/gpu/vulkan/shim standing in for
# the parts of shadPS4 we do not take (settings, memory manager, signals,
# logging, ImGui, window, PM4 front end).
#
# Dependencies come from, in order: targets already defined, system packages,
# a shadPS4 checkout's externals (DC_SHADPS4_EXTERNALS, default ./shadps4/externals),
# or FetchContent at the versions below.

include(FetchContent)

set(DC_SHADPS4_EXTERNALS "${CMAKE_SOURCE_DIR}/shadps4/externals" CACHE PATH
    "shadPS4 externals directory to take Vulkan renderer dependencies from")

# dc_external(<var> <name> <git repo> <git tag>): sets <var> to a source dir.
function(dc_external out name repo tag)
    if (EXISTS "${DC_SHADPS4_EXTERNALS}/${name}/CMakeLists.txt" OR
        EXISTS "${DC_SHADPS4_EXTERNALS}/${name}/include" OR
        EXISTS "${DC_SHADPS4_EXTERNALS}/${name}/${name}.h")
        set(${out} "${DC_SHADPS4_EXTERNALS}/${name}" PARENT_SCOPE)
        return()
    endif()
    string(MAKE_C_IDENTIFIER "dcext_${name}" fc_name)
    FetchContent_Declare(${fc_name} GIT_REPOSITORY ${repo} GIT_TAG ${tag} GIT_SHALLOW TRUE)
    FetchContent_GetProperties(${fc_name})
    if (NOT ${fc_name}_POPULATED)
        message(STATUS "Vulkan renderer: fetching ${name} ${tag}")
        FetchContent_Populate(${fc_name})
    endif()
    set(${out} "${${fc_name}_SOURCE_DIR}" PARENT_SCOPE)
endfunction()

