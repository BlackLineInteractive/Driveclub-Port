+static int dc_trace = -1;
+static void trace(const char *what) {
+    if (dc_trace < 0) dc_trace = getenv("BB_DC_TRACE") && *getenv("BB_DC_TRACE") == '1';
+    if (dc_trace) printf("DC: %s\n", what);
+}
