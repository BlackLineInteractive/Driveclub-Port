+/* --- POSIX semaphores and rwlocks (libScePosix) ----------------------------------------- */
+/* Guest sem_t and pthread_rwlock_t are pointer-sized handles. */
+typedef struct { pthread_mutex_t lock; pthread_cond_t cond; uint32_t count; } HostSem;
+static ABI int32_t posix_sem_init(HostSem **sem, int32_t shared, uint32_t value) {
+    if (!sem) return -1;
+    HostSem *s = calloc(1, sizeof(*s));
+    if (!s) return -1;
+    pthread_mutex_init(&s->lock, NULL);
+    pthread_cond_init(&s->cond, NULL);
+    s->count = value;
+    *sem = s;
+    return 0;
+}
+static ABI int32_t posix_sem_destroy(HostSem **sem) {
+    if (!sem || !*sem) return -1;
+    pthread_mutex_destroy(&(*sem)->lock);
+    pthread_cond_destroy(&(*sem)->cond);
+    free(*sem);
+    *sem = NULL;
+    return 0;
+}
+static ABI int32_t posix_sem_wait(HostSem **sem) {
+    if (!sem || !*sem) return -1;
+    HostSem *s = *sem;
+    pthread_mutex_lock(&s->lock);
+    while (!s->count) pthread_cond_wait(&s->cond, &s->lock);
+    --s->count;
+    pthread_mutex_unlock(&s->lock);
+    return 0;
+}
+static ABI int32_t posix_sem_trywait(HostSem **sem) {
+    if (!sem || !*sem) return -1;
+    HostSem *s = *sem;
+    pthread_mutex_lock(&s->lock);
+    int32_t r = s->count ? (--s->count, 0) : -1;
+    pthread_mutex_unlock(&s->lock);
+    if (r) *runtime_errno() = POSIX_EAGAIN;
+    return r;
+}
+static ABI int32_t posix_sem_post(HostSem **sem) {
+    if (!sem || !*sem) return -1;
+    HostSem *s = *sem;
+    pthread_mutex_lock(&s->lock);
+    ++s->count;
+    pthread_cond_signal(&s->cond);
+    pthread_mutex_unlock(&s->lock);
+    return 0;
+}
+static ABI int32_t posix_sem_getvalue(HostSem **sem, int32_t *value) {
+    if (!sem || !*sem || !value) return -1;
+    pthread_mutex_lock(&(*sem)->lock);
+    *value = (int32_t)(*sem)->count;
+    pthread_mutex_unlock(&(*sem)->lock);
+    return 0;
+}
+
+static pthread_mutex_t rwlock_init_lock = PTHREAD_MUTEX_INITIALIZER;
+/* Static initializers leave the guest handle NULL: create the host lock on first use. */
+static pthread_rwlock_t *rwlock(pthread_rwlock_t **handle) {
+    if (!handle) return NULL;
+    pthread_rwlock_t *l = __atomic_load_n(handle, __ATOMIC_ACQUIRE);
+    if (l) return l;
+    pthread_mutex_lock(&rwlock_init_lock);
+    if (!*handle) {
+        l = malloc(sizeof(*l));
+        if (l) pthread_rwlock_init(l, NULL);
+        __atomic_store_n(handle, l, __ATOMIC_RELEASE);
+    }
+    l = *handle;
+    pthread_mutex_unlock(&rwlock_init_lock);
+    return l;
+}
+static ABI int32_t posix_rwlock_init(pthread_rwlock_t **handle, const void *attr) {
+    if (!handle) return POSIX_EINVAL;
+    *handle = NULL;
+    return rwlock(handle) ? 0 : POSIX_EINVAL;
+}
+static ABI int32_t posix_rwlock_destroy(pthread_rwlock_t **handle) {
+    if (!handle || !*handle) return 0;
+    pthread_rwlock_destroy(*handle);
+    free(*handle);
+    *handle = NULL;
+    return 0;
+}
+static ABI int32_t posix_rwlock_rdlock(pthread_rwlock_t **h) { pthread_rwlock_t *l = rwlock(h); return l ? pthread_rwlock_rdlock(l) : POSIX_EINVAL; }
+static ABI int32_t posix_rwlock_wrlock(pthread_rwlock_t **h) { pthread_rwlock_t *l = rwlock(h); return l ? pthread_rwlock_wrlock(l) : POSIX_EINVAL; }
+static ABI int32_t posix_rwlock_tryrdlock(pthread_rwlock_t **h) { pthread_rwlock_t *l = rwlock(h); return l ? (pthread_rwlock_tryrdlock(l) ? POSIX_EBUSY : 0) : POSIX_EINVAL; }
+static ABI int32_t posix_rwlock_trywrlock(pthread_rwlock_t **h) { pthread_rwlock_t *l = rwlock(h); return l ? (pthread_rwlock_trywrlock(l) ? POSIX_EBUSY : 0) : POSIX_EINVAL; }
+static ABI int32_t posix_rwlock_unlock(pthread_rwlock_t **h) { pthread_rwlock_t *l = rwlock(h); return l ? pthread_rwlock_unlock(l) : POSIX_EINVAL; }
+
+/* pthread_detach: scePthreadDetach's contract with a POSIX error number. */
+static ABI int32_t posix_detach(void *thread) {
+    typedef int32_t (ABI *Detach)(void *);
+    static Detach detach;
+    if (!detach) detach = (Detach)runtime_resolve("4qGrR6eoP9Y#p#J", 0);
+    int32_t r = detach ? detach(thread) : 0;
+    return r ? r & 0xffff : 0;
+}
