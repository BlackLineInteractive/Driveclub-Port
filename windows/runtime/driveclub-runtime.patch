+        return; // the first draw copies the finished frame; the second is the HUD's first
+    }
+    auto& image = texture_cache.GetImage(display);
+    vk::Format raw{};
+    switch (image.info.pixel_format) {
+    case vk::Format::eB8G8R8A8Unorm:
+    case vk::Format::eB8G8R8A8Srgb:
+        raw = vk::Format::eB8G8R8A8Unorm;
+        break;
+    case vk::Format::eR8G8B8A8Unorm:
+    case vk::Format::eR8G8B8A8Srgb:
+        raw = vk::Format::eR8G8B8A8Unorm;
+        break;
+    default:
+        return; // 10-bit or HDR buffers: the HUD stays in the interpolated frames
+    }
+    const u32 w = image.info.size.width, h = image.info.size.height;
+    if (!hudless_image || hudless_format != raw || hudless_width != w || hudless_height != h) {
+        // The previous copy may still be read: freed once the GPU is past this point (no wait
+        // here, on the recording thread).
+        if (hudless_image) {
+            scheduler.DeferOperation([old = std::move(hudless_image)]() mutable {});
+        }
+        hudless_image = VideoCore::UniqueImage(instance.GetDevice(), instance.GetAllocator());
+        hudless_image.Create(vk::ImageCreateInfo{
+            .imageType = vk::ImageType::e2D,
+            .format = raw,
+            .extent = {w, h, 1},
+            .mipLevels = 1,
+            .arrayLayers = 1,
+            .samples = vk::SampleCountFlagBits::e1,
+            .tiling = vk::ImageTiling::eOptimal,
+            .usage = vk::ImageUsageFlagBits::eTransferDst | vk::ImageUsageFlagBits::eTransferSrc,
+            .initialLayout = vk::ImageLayout::eUndefined,
+        });
+        hudless_format = raw;
+        hudless_width = w;
+        hudless_height = h;
+    }
+    scheduler.EndRendering();
+    runtime.Transit(&image, vk::ImageLayout::eTransferSrcOptimal,
+                    vk::PipelineStageFlagBits2::eTransfer, vk::AccessFlagBits2::eTransferRead);
+    runtime.FlushBarriers();
+    const auto cmdbuf = scheduler.CommandBuffer();
+    const auto layout = [&](vk::ImageLayout from, vk::ImageLayout to, vk::AccessFlags2 src,
+                            vk::AccessFlags2 dst) {
+        const vk::ImageMemoryBarrier2 barrier{
+            .srcStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+            .srcAccessMask = src,
+            .dstStageMask = vk::PipelineStageFlagBits2::eAllCommands,
+            .dstAccessMask = dst,
+            .oldLayout = from,
+            .newLayout = to,
+            .image = vk::Image(hudless_image),
+            .subresourceRange = {vk::ImageAspectFlagBits::eColor, 0, 1, 0, 1},
+        };
+        cmdbuf.pipelineBarrier2({.imageMemoryBarrierCount = 1, .pImageMemoryBarriers = &barrier});
+    };
+    layout(vk::ImageLayout::eUndefined, vk::ImageLayout::eTransferDstOptimal,
+           vk::AccessFlagBits2::eNone, vk::AccessFlagBits2::eTransferWrite);
+    // A raw copy: the sRGB buffer's bytes as they are, like the presented frame's.
+    const vk::ImageCopy copy{
+        .srcSubresource = {vk::ImageAspectFlagBits::eColor, 0, 0, 1},
+        .dstSubresource = {vk::ImageAspectFlagBits::eColor, 0, 0, 1},
+        .extent = {w, h, 1},
+    };
+    cmdbuf.copyImage(image.GetImage(), vk::ImageLayout::eTransferSrcOptimal,
+                     vk::Image(hudless_image), vk::ImageLayout::eTransferDstOptimal, copy);
+    layout(vk::ImageLayout::eTransferDstOptimal, vk::ImageLayout::eTransferSrcOptimal,
+           vk::AccessFlagBits2::eTransferWrite, vk::AccessFlagBits2::eTransferRead);
+    fg_inputs.hudless = vk::Image(hudless_image);
+    fg_inputs.hudless_format = raw;
+    fg_inputs.hudless_width = w;
+    fg_inputs.hudless_height = h;
+}
+
+void TemporalUpscaler::CreateDcPipelines() {
+    if (dc_motion_pipeline) {
+        return;
+    }
+    const auto device = instance.GetDevice();
+    const auto make = [&](std::span<const vk::DescriptorType> types,
+                          vk::UniqueDescriptorSetLayout& set_layout,
+                          vk::UniquePipelineLayout& pipeline_layout, u32 push_size,
+                          const auto& code, vk::UniquePipeline& pipeline) {
+        std::array<vk::DescriptorSetLayoutBinding, 8> bindings{};
+        for (u32 i = 0; i < types.size(); ++i) {
+            bindings[i] = {.binding = i,
+                           .descriptorType = types[i],
+                           .descriptorCount = 1,
+                           .stageFlags = vk::ShaderStageFlagBits::eCompute};
+        }
+        set_layout = Check(device.createDescriptorSetLayoutUnique({
+            .flags = vk::DescriptorSetLayoutCreateFlagBits::ePushDescriptorKHR,
+            .bindingCount = u32(types.size()),
+            .pBindings = bindings.data(),
+        }));
+        const vk::PushConstantRange push{.stageFlags = vk::ShaderStageFlagBits::eCompute,
+                                         .offset = 0,
+                                         .size = push_size};
+        pipeline_layout = Check(device.createPipelineLayoutUnique({
+            .setLayoutCount = 1,
+            .pSetLayouts = &*set_layout,
+            .pushConstantRangeCount = 1,
+            .pPushConstantRanges = &push,
+        }));
+        const auto module = CompileSPV(code, device);
+        pipeline = Check(device.createComputePipelineUnique(
+            {}, vk::ComputePipelineCreateInfo{
+                    .stage = {.stage = vk::ShaderStageFlagBits::eCompute,
+                              .module = module,
+                              .pName = "main"},
+                    .layout = *pipeline_layout,
+                }));
+        device.destroyShaderModule(module);
+    };
+    static constexpr std::array motion_types = {
+        vk::DescriptorType::eStorageBuffer, vk::DescriptorType::eStorageBuffer,
+        vk::DescriptorType::eStorageBuffer, vk::DescriptorType::eSampledImage,
+        vk::DescriptorType::eSampledImage,  vk::DescriptorType::eStorageImage,
+        vk::DescriptorType::eStorageImage,
+    };
+    make(motion_types, dc_motion_desc_layout, dc_motion_pipeline_layout, 8 * sizeof(u32),
+         DC_MOTION_COMP, dc_motion_pipeline);
+    static constexpr std::array merge_types = {
+        vk::DescriptorType::eSampledImage,
+        vk::DescriptorType::eStorageImage,
+        vk::DescriptorType::eSampledImage,
+    };
+    make(merge_types, dc_merge_desc_layout, dc_merge_pipeline_layout, 4 * sizeof(u32),
+         DC_MERGE_COMP, dc_merge_pipeline);
+}
+
+bool TemporalUpscaler::RunDriveclub(const DcInputs& inputs) {
+    // BB_FG_STATS=1: why the resolve was not replaced, every 300 resolves.
+    static const bool stats = std::getenv("BB_FG_STATS") != nullptr;
+    static u32 calls, already, inactive, no_depth, no_ids, no_color;
+    if (stats && ++calls == 300) {
+        std::printf("Upscaler (Driveclub): of 300 resolves: %u after another this frame, %u "
+                    "inactive, missing depth %u, object ids %u, scene color %u\n",
+                    already, inactive, no_depth, no_ids, no_color);
+        calls = already = inactive = no_depth = no_ids = no_color = 0;
+    }
+    if (!dc_mode || done_this_frame) {
+        already += dc_mode;
+        return false;
+    }
+    done_this_frame = true;
+    const int provider = BbSettings::Get().upscaler.load();
+    if (failed || !Active() || provider == BbSettings::UpscalerTaa ||
+        provider == BbSettings::UpscalerDlss || !dc_depth || !dc_object_ids || !dc_color) {
+        inactive += failed || !Active();
+        no_depth += !dc_depth;
+        no_ids += !dc_object_ids;
+        no_color += !dc_color;
+        // Once per session in every log: why the game's own TAA stayed.
+        static bool told_inactive, told_targets;
+        if ((failed || !Active()) && !told_inactive && provider != BbSettings::UpscalerOff) {
+            told_inactive = true;
+            std::printf("Upscaler (Driveclub): not running (%s)\n",
+                        failed ? "it failed earlier" : "upscaler not active");
+        } else if (!(failed || !Active()) && !told_targets) {
+            told_targets = true;
+            std::printf("Upscaler (Driveclub): skipped a resolve: scene targets not found "
+                        "(depth %d, object ids %d, scene color %d)\n",
+                        bool(dc_depth), bool(dc_object_ids), bool(dc_color));
+        }
+        reset = true;
+        return false;
+    }
+    auto& color = texture_cache.GetImage(dc_color);
+    auto& depth = texture_cache.GetImage(dc_depth);
+    auto& ids = texture_cache.GetImage(dc_object_ids);
+    const u32 w = color.info.size.width, h = color.info.size.height;
+    if (depth.info.size.width != w || depth.info.size.height != h ||
+        ids.info.size.width != w || ids.info.size.height != h ||
+        !(color.usage_flags & vk::ImageUsageFlagBits::eStorage)) {
+        static bool printed = false;
+        if (!printed) {
+            printed = true;
+            std::printf("Upscaler (Driveclub): scene targets do not match (%ux%u)\n", w, h);
+        }
+        return false;
+    }
+    if (!EnsureResources(w, h, w, h, true)) {
+        failed = true;
+        return false;
+    }
+    CreateDcPipelines();
+    dc_vertical_fov = 2.0f * std::atan(std::abs(inputs.tan_half_fov_y));
+    if (!(dc_vertical_fov > 0.1f && dc_vertical_fov < 3.0f)) {
+        dc_vertical_fov = 1.0472f;
+    }
+    if (auto* profiler = GpuProfiler::Get()) {
+        profiler->Mark(0xDC00'0000ull, [] { return std::string{"upscaler Run (Driveclub)"}; });
+    }
+
+    const auto depth_view =
+        CachedView(depth, depth.info.pixel_format, vk::ImageAspectFlagBits::eDepth);
+    const auto color_view =
+        CachedView(color, color.info.pixel_format, vk::ImageAspectFlagBits::eColor);
+    const auto ids_view = CachedView(ids, ids.info.pixel_format, vk::ImageAspectFlagBits::eColor);
+
+    scheduler.EndRendering();
+    runtime.Transit(&depth, vk::ImageLayout::eGeneral, vk::PipelineStageFlagBits2::eComputeShader,
+                    vk::AccessFlagBits2::eShaderRead);
+    runtime.Transit(&ids, vk::ImageLayout::eGeneral, vk::PipelineStageFlagBits2::eComputeShader,
+                    vk::AccessFlagBits2::eShaderRead);
+    runtime.Transit(&color, vk::ImageLayout::eGeneral, vk::PipelineStageFlagBits2::eComputeShader,
+                    vk::AccessFlagBits2::eShaderRead);
+    runtime.FlushBarriers();
+    const auto cmdbuf = scheduler.CommandBuffer();
+
+    const auto own_barrier = [&](vk::Image image, vk::ImageLayout old_layout,
+                                 vk::PipelineStageFlags2 src_stage, vk::AccessFlags2 src_access,
+                                 vk::ImageLayout new_layout, vk::PipelineStageFlags2 dst_stage,
+                                 vk::AccessFlags2 dst_access) {
+        const vk::ImageMemoryBarrier2 barrier{
+            .srcStageMask = src_stage,
+            .srcAccessMask = src_access,
+            .dstStageMask = dst_stage,
+            .dstAccessMask = dst_access,
+            .oldLayout = old_layout,
+            .newLayout = new_layout,
+            .image = image,
+            .subresourceRange = {vk::ImageAspectFlagBits::eColor, 0, 1, 0, 1},
+        };
+        cmdbuf.pipelineBarrier2({.imageMemoryBarrierCount = 1, .pImageMemoryBarriers = &barrier});
+    };
+    const auto all = vk::PipelineStageFlagBits2::eAllCommands;
+    const auto rw = vk::AccessFlagBits2::eShaderRead | vk::AccessFlagBits2::eShaderWrite;
+    own_barrier(vk::Image(motion_image), vk::ImageLayout::eUndefined, all,
+                vk::AccessFlagBits2::eNone, vk::ImageLayout::eGeneral,
+                vk::PipelineStageFlagBits2::eComputeShader, vk::AccessFlagBits2::eShaderWrite);
+    own_barrier(vk::Image(output_image), vk::ImageLayout::eUndefined, all,
+                vk::AccessFlagBits2::eNone, vk::ImageLayout::eGeneral, all, rw);
+    own_barrier(vk::Image(depth_copy_image), vk::ImageLayout::eUndefined, all,
+                vk::AccessFlagBits2::eNone, vk::ImageLayout::eGeneral,
+                vk::PipelineStageFlagBits2::eComputeShader, vk::AccessFlagBits2::eShaderWrite);
+
+    // Motion vectors from the resolve's reprojection (dc_motion.comp).
+    {
+        std::array<vk::DescriptorBufferInfo, 3> buffers{};
+        for (u32 i = 0; i < 3; ++i) {
+            buffers[i] = {.buffer = inputs.buffers[i].buffer,
+                          .offset = inputs.buffers[i].offset,
+                          .range = inputs.buffers[i].size};
+        }
+        const vk::DescriptorImageInfo ids_info{.imageView = ids_view,
+                                               .imageLayout = vk::ImageLayout::eGeneral};
+        const vk::DescriptorImageInfo depth_info{.imageView = depth_view,
+                                                 .imageLayout = vk::ImageLayout::eGeneral};
+        const vk::DescriptorImageInfo motion_info{.imageView = *motion_view,
+                                                  .imageLayout = vk::ImageLayout::eGeneral};
+        const vk::DescriptorImageInfo depth_copy_info{.imageView = *depth_copy_view,
+                                                      .imageLayout = vk::ImageLayout::eGeneral};
+        std::array<vk::WriteDescriptorSet, 7> writes{};
+        for (u32 i = 0; i < 3; ++i) {
+            writes[i] = {.dstBinding = i,
+                         .descriptorCount = 1,
+                         .descriptorType = vk::DescriptorType::eStorageBuffer,
+                         .pBufferInfo = &buffers[i]};
+        }
+        writes[3] = {.dstBinding = 3,
+                     .descriptorCount = 1,
+                     .descriptorType = vk::DescriptorType::eSampledImage,
+                     .pImageInfo = &ids_info};
+        writes[4] = {.dstBinding = 4,
+                     .descriptorCount = 1,
+                     .descriptorType = vk::DescriptorType::eSampledImage,
+                     .pImageInfo = &depth_info};
+        writes[5] = {.dstBinding = 5,
+                     .descriptorCount = 1,
+                     .descriptorType = vk::DescriptorType::eStorageImage,
+                     .pImageInfo = &motion_info};
+        writes[6] = {.dstBinding = 6,
+                     .descriptorCount = 1,
+                     .descriptorType = vk::DescriptorType::eStorageImage,
+                     .pImageInfo = &depth_copy_info};
+        struct {
+            float size[2], jitter[2];
+            u32 offsets[4];
+        } push = {{float(w), float(h)},
+                  {jitter[0], jitter[1]},
+                  {inputs.dword_offsets[0], inputs.dword_offsets[1], inputs.dword_offsets[2], 0}};
+        cmdbuf.bindPipeline(vk::PipelineBindPoint::eCompute, *dc_motion_pipeline);
+        cmdbuf.pushDescriptorSetKHR(vk::PipelineBindPoint::eCompute, *dc_motion_pipeline_layout, 0,
+                                    writes);
+        cmdbuf.pushConstants(*dc_motion_pipeline_layout, vk::ShaderStageFlagBits::eCompute, 0,
+                             sizeof(push), &push);
+        cmdbuf.dispatch((w + 7) / 8, (h + 7) / 8, 1);
+    }
+    own_barrier(vk::Image(motion_image), vk::ImageLayout::eGeneral,
+                vk::PipelineStageFlagBits2::eComputeShader, vk::AccessFlagBits2::eShaderWrite,
+                vk::ImageLayout::eGeneral, all, vk::AccessFlagBits2::eShaderRead);
+    own_barrier(vk::Image(depth_copy_image), vk::ImageLayout::eGeneral,
+                vk::PipelineStageFlagBits2::eComputeShader, vk::AccessFlagBits2::eShaderWrite,
+                vk::ImageLayout::eGeneral, all, vk::AccessFlagBits2::eShaderRead);
+
+    const auto now = std::chrono::steady_clock::now();
+    float frame_ms = std::chrono::duration<float, std::milli>(now - last_frame).count();
+    if (frame_ms <= 0.0f || frame_ms > 200.0f) {
+        frame_ms = 16.6f;
+    }
+    last_frame = now;
+    // For the presenter's frame generation at this frame's flip.
+    fg_inputs = {vk::Image(depth_copy_image), vk::Image(motion_image), w, h, dc_near,
+                 dc_vertical_fov, frame_ms, reset};
+    fg_ready = true;
+    fg_display_draws = 0;
+    ++fg_handed;
+
+    bool dispatched = false;
+    if (UseFsr4()) {
+        dispatched = RecordFsr4(cmdbuf, {color.GetImage(), color_view, w, h},
+                                {depth.GetImage(), depth_view, w, h}, w, h, w, h, frame_ms);
+    } else {
+        FfxVkPortableUpscaleDispatchInfo info{};
+        info.structSize = sizeof(info);
+        info.commandBuffer = cmdbuf;
+        info.color = Describe(color.GetImage(), color.info.pixel_format, w, h, color.usage_flags,
+                              vk::ImageAspectFlagBits::eColor,
+                              FFX_VK_PORTABLE_RESOURCE_STATE_GENERIC_READ);
+        info.depth = Describe(depth.GetImage(), depth.info.pixel_format, w, h, depth.usage_flags,
+                              vk::ImageAspectFlagBits::eDepth,
+                              FFX_VK_PORTABLE_RESOURCE_STATE_GENERIC_READ);
+        info.motionVectors = Describe(vk::Image(motion_image), vk::Format::eR16G16Sfloat, w, h,
+                                      vk::ImageUsageFlagBits::eStorage |
+                                          vk::ImageUsageFlagBits::eSampled,
+                                      vk::ImageAspectFlagBits::eColor,
+                                      FFX_VK_PORTABLE_RESOURCE_STATE_GENERIC_READ);
+        info.output = Describe(vk::Image(output_image), vk::Format::eR16G16B16A16Sfloat, w, h,
+                               vk::ImageUsageFlagBits::eStorage | vk::ImageUsageFlagBits::eSampled |
+                                   vk::ImageUsageFlagBits::eTransferSrc,
+                               vk::ImageAspectFlagBits::eColor,
+                               FFX_VK_PORTABLE_RESOURCE_STATE_UNORDERED_ACCESS);
+        info.exposure.structSize = sizeof(info.exposure);
+        info.reactiveMask.structSize = sizeof(info.reactiveMask);
+        info.transparencyAndCompositionMask.structSize =
+            sizeof(info.transparencyAndCompositionMask);
+        // The menu's invert-jitter option applies to FSR 3 here too (A/B of the convention).
+        const float sign = BbToggle::Disabled(1u << 26) != BbSettings::Get().fsr4_invert_jitter.load()
+                               ? -1.0f
+                               : 1.0f;
+        info.jitterOffset = {sign * jitter[0], sign * jitter[1]};
+        info.motionVectorScale = {1.0f, 1.0f};
+        info.renderSize = {w, h};
+        info.outputSize = {w, h};
+        info.frameTimeMilliseconds = frame_ms;
+        info.preExposure = 1.0f;
+        info.cameraNear = dc_near;
+        info.cameraFar = 1.0e6f;
+        info.cameraVerticalFovRadians = dc_vertical_fov;
+        info.viewSpaceToMeters = 1.0f;
+        info.sharpness = std::min(BbSettings::Get().sharpness.load(), 1.0f);
+        info.enableSharpening = BbSettings::Get().sharpen ? VK_TRUE : VK_FALSE;
+        info.reset = reset ? VK_TRUE : VK_FALSE;
+        info.frameId = frame_id++;
+        FfxVkPortableUpscaleCreateInfo create_info{};
+        create_info.structSize = sizeof(create_info);
+        create_info.flags = FFX_VK_PORTABLE_CONTEXT_HDR_COLOR_INPUT |
+                            FFX_VK_PORTABLE_CONTEXT_AUTO_EXPOSURE |
+                            FFX_VK_PORTABLE_CONTEXT_DEPTH_INVERTED |
+                            FFX_VK_PORTABLE_CONTEXT_DEPTH_INFINITE;
+        create_info.maxRenderSize = {w, h};
+        create_info.maxOutputSize = {w, h};
+        if (const u64 issues = ffxVkPortableValidateUpscaleDispatchInfo(&create_info, &info)) {
+            static bool printed = false;
+            if (!printed) {
+                printed = true;
+                PrintIssues("dispatch (Driveclub)", issues);
+            }
+            failed = true;
+        } else if (ffxVkPortableUpscaleContextRecordDispatch(context, &info) !=
+                   FFX_VK_PORTABLE_OK) {
+            std::printf("Upscaler (Driveclub): FSR 3 dispatch failed\n");
+            failed = true;
+        } else {
+            dispatched = true;
+        }
+    }
+    if (!dispatched) {
+        return false;
+    }
+    reset = false;
+    dispatched_last_frame = true;
+    ExtraSharpen(cmdbuf, vk::Image(output_image), false, w, h);
+
+    // The result into the scene color (dc_merge.comp).
+    own_barrier(vk::Image(output_image), vk::ImageLayout::eGeneral, all, rw,
+                vk::ImageLayout::eGeneral, vk::PipelineStageFlagBits2::eComputeShader,
+                vk::AccessFlagBits2::eShaderRead);
+    runtime.Transit(&color, vk::ImageLayout::eGeneral, vk::PipelineStageFlagBits2::eComputeShader,
+                    vk::AccessFlagBits2::eShaderRead | vk::AccessFlagBits2::eShaderWrite);
+    runtime.FlushBarriers();
+    {
+        const vk::DescriptorImageInfo out_info{.imageView = *output_view,
+                                               .imageLayout = vk::ImageLayout::eGeneral};
+        const vk::DescriptorImageInfo scene_info{.imageView = color_view,
+                                                 .imageLayout = vk::ImageLayout::eGeneral};
+        const vk::DescriptorImageInfo motion_info{.imageView = *motion_view,
+                                                  .imageLayout = vk::ImageLayout::eGeneral};
+        const std::array<vk::WriteDescriptorSet, 3> writes = {{
+            {.dstBinding = 0,
+             .descriptorCount = 1,
+             .descriptorType = vk::DescriptorType::eSampledImage,
+             .pImageInfo = &out_info},
+            {.dstBinding = 1,
+             .descriptorCount = 1,
+             .descriptorType = vk::DescriptorType::eStorageImage,
+             .pImageInfo = &scene_info},
+            {.dstBinding = 2,
+             .descriptorCount = 1,
+             .descriptorType = vk::DescriptorType::eSampledImage,
+             .pImageInfo = &motion_info},
+        }};
+        static const bool debug_motion = std::getenv("BB_DC_DEBUG_MOTION") != nullptr;
+        const std::array<u32, 4> size = {w, h, debug_motion ? 1u : 0u, 0u};
+        cmdbuf.bindPipeline(vk::PipelineBindPoint::eCompute, *dc_merge_pipeline);
+        cmdbuf.pushDescriptorSetKHR(vk::PipelineBindPoint::eCompute, *dc_merge_pipeline_layout, 0,
+                                    writes);
+        cmdbuf.pushConstants(*dc_merge_pipeline_layout, vk::ShaderStageFlagBits::eCompute, 0,
+                             sizeof(size), size.data());
+        cmdbuf.dispatch((w + 7) / 8, (h + 7) / 8, 1);
+    }
+    // The resolve that follows reads the scene color.
+    runtime.Transit(&color, vk::ImageLayout::eGeneral, vk::PipelineStageFlagBits2::eComputeShader,
+                    vk::AccessFlagBits2::eShaderRead);
+    color.flags |= VideoCore::ImageFlagBits::GpuModified;
+    return true;
+}
+
 } // namespace Vulkan
diff --git a/gpu/shadps4/video_core/renderer_vulkan/vk_temporal_upscaler.h b/gpu/shadps4/video_core/renderer_vulkan/vk_temporal_upscaler.h
index 4067dfb..def3bc7 100644
--- a/gpu/shadps4/video_core/renderer_vulkan/vk_temporal_upscaler.h
+++ b/gpu/shadps4/video_core/renderer_vulkan/vk_temporal_upscaler.h
@@ -63,6 +63,68 @@ public:
     /// Before a compute dispatch: the post-processing combine shader triggers the upscale.
     void OnDispatch(u64 cs_hash);
 
+    // Driveclub (BB_DC_UPSCALE=1): Native AA in place of the game's own TAA resolve. The G-buffer
+    // pass gives the scene depth and the object IDs, the last R11G11B10 target drawn with that
+    // depth is the scene color, and the TAA resolve's buffers give the motion (dc_motion.comp).
+
+    [[nodiscard]] bool DcMode() const noexcept {
+        return dc_mode;
+    }
+    /// The main view's depth target (kept across frames: its draws are jittered).
+    [[nodiscard]] VideoCore::ImageId DcDepth() const noexcept {
+        return dc_depth;
+    }
+    /// The TAA resolve shader (compute 0x403f86d4: menus, garage, some events). Its variants
+    /// for other scenes (0x430587e6 in races, 0xfdd72cf1) bind the same constant buffers with
+    /// the same layout and differ only in their images.
+    static constexpr u64 DcTaaHash = 0x403f86d4;
+    static constexpr bool IsDcTaa(u64 hash) {
+        return hash == DcTaaHash || hash == 0x430587e6 || hash == 0xfdd72cf1;
+    }
+    void OnDcGBuffer(VideoCore::ImageId depth, VideoCore::ImageId object_ids);
+    void OnDcSceneColor(VideoCore::ImageId color);
+    struct DcBuffer {
+        vk::Buffer buffer;
+        u64 offset, size;
+    };
