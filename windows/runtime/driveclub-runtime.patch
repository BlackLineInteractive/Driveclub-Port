new file mode 100644
index 0000000..0fbf48a
--- /dev/null
+++ b/gpu/shadps4/video_core/host_shaders/dc_merge.comp
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Driveclub: the upscaled scene back into the game's R11G11B10 scene color, stored as the
+// color block would (negatives and NaN as 0, overflow as the largest finite value).
+#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+
+layout(local_size_x = 8, local_size_y = 8) in;
+
+layout(binding = 0) uniform texture2D upscaled;
+layout(binding = 1) uniform writeonly image2D scene_img;
+layout(binding = 2) uniform texture2D motion_tex; // pixels, previous - current
+
+layout(push_constant) uniform Constants {
+    uvec2 size;
+    uint mode; // 0 upscaled scene, 1 motion vectors (BB_DC_DEBUG_MOTION=1)
+};
+
+void main() {
+    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
+    if (any(greaterThanEqual(uvec2(pixel), size))) {
+        return;
+    }
+    vec3 color = texelFetch(upscaled, pixel, 0).rgb;
+    if (mode == 1u) {
+        // Motion: red right, green down, blue its length; 0.5 is still (16 px full scale).
+        const vec2 m = texelFetch(motion_tex, pixel, 0).xy;
+        color = vec3(0.5 + m / 32.0, length(m) / 16.0) * 0.5;
+    }
+    const vec3 stored = mix(vec3(0.0), min(color, vec3(65024.0)), greaterThan(color, vec3(0.0)));
+    imageStore(scene_img, pixel, vec4(stored, 1.0));
+}
diff --git a/gpu/shadps4/video_core/host_shaders/dc_motion.comp b/gpu/shadps4/video_core/host_shaders/dc_motion.comp
new file mode 100644
index 0000000..de5d757
--- /dev/null
+++ b/gpu/shadps4/video_core/host_shaders/dc_motion.comp
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Driveclub: motion vectors for the temporal upscaler, by the reprojection of the game's own TAA
+// resolve (compute shader 0x403f86d4): the view position from the depth and the frame's view
+// ray, through the current -> previous transform of the pixel's object (the world or a car),
+// projected with the previous frame's camera. Pixels, previous - current, like camera_motion.
+#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+
+layout(local_size_x = 8, local_size_y = 8) in;
+
+// The TAA resolve's buffers: frame constants, camera constants, and the object transforms
+// (48 dwords per object; rows 16, 20, 24, 28 map view x, y, z and 1 to the previous clip).
+layout(binding = 0, std430) readonly buffer Frame { uint frame_data[]; };
+layout(binding = 1, std430) readonly buffer Camera { uint camera_data[]; };
+layout(binding = 2, std430) readonly buffer Objects { uint object_data[]; };
+layout(binding = 3) uniform texture2D gbuffer_tex; // RGBA8; alpha * 255, low 6 bits: object
+layout(binding = 4) uniform texture2D depth_tex;   // D32, reversed (1 = near)
+layout(binding = 5, rg16f) uniform writeonly image2D motion_img;
+
+layout(push_constant) uniform Constants {
+    vec2 size;      // pixels
+    vec2 jitter;    // this frame's viewport shift in pixels (x right, y down)
+    uvec4 offsets;  // dwords from each binding's (aligned) start to the game's buffer
+};
+
+float F(uint v) {
+    return uintBitsToFloat(v);
+}
+
+float Fr(uint i) { return F(frame_data[offsets.x + i]); }
+float Ca(uint i) { return F(camera_data[offsets.y + i]); }
+
+vec4 Row(uint base) {
+    base += offsets.z;
+    return vec4(F(object_data[base]), F(object_data[base + 1u]), F(object_data[base + 2u]),
+                F(object_data[base + 3u]));
+}
+
+void main() {
+    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
+    if (pixel.x >= int(size.x) || pixel.y >= int(size.y)) {
+        return;
+    }
+    // Depth was rasterised through a shifted viewport: the unjittered position, and no jitter
+    // in the motion vectors.
+    const vec2 uv = (vec2(pixel) + 0.5) / size - jitter / size;
+    const float depth = texelFetch(depth_tex, pixel, 0).r;
+    const uint object = uint(texelFetch(gbuffer_tex, pixel, 0).a * 255.0 + 0.5) & 63u;
+
+    const float ray_x = (Fr(76u) * uv.x + Fr(78u)) * Fr(94u) + Fr(92u);
+    const float ray_y = (Fr(77u) * uv.y + Fr(79u)) * Fr(95u) + Fr(93u);
+    const float z = 1.0 / -(Ca(118u) * depth + Ca(119u));
+    const float view_x = z * ray_x;
+    const float view_y = z * ray_y;
+
+    const uint base = object * 48u;
+    const vec4 col_x = Row(base + 16u), col_y = Row(base + 20u), col_z = Row(base + 24u),
+               col_w = Row(base + 28u);
+    const vec4 prev_clip = view_x * col_x + view_y * col_y - z * col_z + col_w;
+    const vec2 prev_uv =
+        vec2(Ca(100u), Ca(101u)) * prev_clip.xy / prev_clip.w + vec2(Ca(102u), Ca(103u));
+    imageStore(motion_img, pixel, vec4((prev_uv - uv) * size, 0.0, 0.0));
+}
diff --git a/gpu/shadps4/video_core/host_shaders/ms_depth_to_color.frag b/gpu/shadps4/video_core/host_shaders/ms_depth_to_color.frag
new file mode 100644
index 0000000..941eb89
--- /dev/null
+++ b/gpu/shadps4/video_core/host_shaders/ms_depth_to_color.frag
@@ -0,0 +1,25 @@
+// SPDX-FileCopyrightText: Copyright 2026 shadPS4 Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#version 450 core
+#extension GL_EXT_samplerless_texture_functions : require
+
+// Resolves a multi-sample depth image into a single-sample color image.
+// Source is bound with aspect=Depth; destination is any Rxf color format
+// whose R channel will receive the depth value. G/B left at 0, A at 1 so
+// a shader that reads this as a sampler2D and swizzles to .rrrr or .r
+// sees the expected depth value either way.
+//
+// Sample 0 is representative — averaging all samples would be wrong for
+// depth-based effects that want a specific visibility decision rather than
+// an intermediate value.
+
+layout (binding = 0, set = 0) uniform texture2DMS depth_ms;
+
+layout (location = 0) out vec4 out_color;
+
+void main()
+{
+    const float d = texelFetch(depth_ms, ivec2(gl_FragCoord.xy), 0).r;
+    out_color = vec4(d, 0.0, 0.0, 1.0);
+}
